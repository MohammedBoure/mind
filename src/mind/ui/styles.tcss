/* ════════════════════════════════════════════════════════════════════════════
   mind — Tokyo Night & Modern TUI Styling (Zellij & Helix Inspired)
   High-contrast, rounded borders, smart coordinator/worker separation,
   full support for Nerd Fonts, Developer Fonts, Unicode & Arabic characters.
   ════════════════════════════════════════════════════════════════════════════ */

/* ── Tokyo Night Color Palette Reference ──────────────────────────────────────
   Backgrounds:
     - Screen / Root Canvas:        #1a1b26 (Tokyo Night deep storm)
     - Docked Bars / Deep Surface:  #16161e (Tokyo Night Night)
     - Coordinator Terminal Canvas: #13141f (Tokyo Night Deep Indigo)
     - Worker Terminal Canvas:      #0f141c (Tokyo Night Deep Slate/Black)
     - Card / Dialog Background:    #16161e
     - Surface / Inactive Tabs:     #1f2335
     - Surface Hover / Selected:    #24283b / #292e42 / #3b4261

   Foregrounds & Accents:
     - Primary Foreground:          #c0caf5 (Crisp Tokyo Night text)
     - Headings / White:            #ffffff
     - Muted / Secondary:           #7982a9 (Tokyo Night comment, readable)
     - Subtle Dim:                  #565f89
     - Coordinator Accent:          #bb9af7 (Tokyo Night Purple/Violet)
     - Worker Accent:               #7aa2f7 (Tokyo Night Blue)
     - Cyan / Secondary:            #7dcfff (Tokyo Night Cyan/Aqua)
     - Teal / Active:               #2ac3de
     - Normal Mode / Accent:        #e0af68 (Tokyo Night Warm Gold/Amber)
     - Warning:                     #ff9e64 (Tokyo Night Orange)
     - Success / Running:           #9ece6a (Tokyo Night Green)
     - Danger / Terminated:         #f7768e (Tokyo Night Red)
   ─────────────────────────────────────────────────────────────────────────── */

/* ── Global Screen & Base Elements ─────────────────────────────────────────── */
Screen {
    background: #1a1b26;
    color: #c0caf5;
}

/* Scrollbar styling with Tokyo Night tones */
Scrollbar {
    background: #16161e;
    color: #3b4261;
}

Scrollbar:hover {
    background: #1f2335;
    color: #7aa2f7;
}

/* ── Top Header Bar (Zellij Streamlined Top Ribbon) ────────────────────────── */
HeaderBar {
    dock: top;
    height: 1;
    width: 100%;
    background: #16161e;
    color: #c0caf5;
}

#header-bar {
    dock: top;
    height: 1;
    width: 100%;
    background: #16161e;
    color: #c0caf5;
    layout: horizontal;
    padding: 0 1;
    border-bottom: solid #24283b;
}

#brand-pill {
    width: auto;
    text-style: bold;
    color: #7aa2f7;
    margin-right: 1;
    padding: 0 1;
}

#session-pill {
    width: auto;
    color: #bb9af7;
    background: #24283b;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
    border: round #343b58;
}

#mode-badge {
    width: auto;
    margin-right: 1;
}

#header-spacer {
    width: 1fr;
}

#worker-count-pill {
    width: auto;
    color: #e0af68;
    background: #24283b;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
    border: round #343b58;
}

#quota-pill {
    width: auto;
    color: #9ece6a;
    background: #1f2335;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
    border: round #292e42;
}

#mcp-indicator {
    width: auto;
    color: #9ece6a;
    background: #1f2335;
    padding: 0 1;
    text-style: bold;
    border: round #292e42;
}

/* ── Interrupt & Toast Alerts (Global Toast & Banner) ──────────────────────── */
#interrupt-banner {
    dock: top;
    height: auto;
    max-height: 5;
    display: none;
    background: #24283b;
    border: round #e0af68;
    color: #c0caf5;
    padding: 0 2;
    margin: 0;
}

#interrupt-banner.visible {
    display: block;
}

.interrupt-header {
    text-style: bold;
    color: #e0af68;
}

.interrupt-sender {
    text-style: bold;
    color: #bb9af7;
}

.interrupt-priority-critical {
    color: #f7768e;
    text-style: bold;
}

.interrupt-priority-high {
    color: #ff9e64;
    text-style: bold;
}

.interrupt-priority-normal {
    color: #9ece6a;
}

.interrupt-priority-low {
    color: #7982a9;
}

/* ── Main Workspace Split Layout ───────────────────────────────────────────── */
#workspace-container {
    height: 1fr;
    width: 100%;
    layout: horizontal;
    background: #1a1b26;
}

/* ── Smart Split: Coordinator Pane (Left) vs Workers Pane (Right) ──────────── */

/* Coordinator Pane (#primary-pane) - Distinct Violet / Lavender Signature */
#primary-pane {
    height: 1fr;
    width: 1fr;
    min-width: 32;
    background: #151622;
    border-right: solid #292e42;
    layout: vertical;
    padding: 0;
    margin: 0;
}

#primary-pane .terminal-header {
    dock: top;
    height: 1;
    background: #1e1e2e;
    color: #c0caf5;
    padding: 0 1;
    border-bottom: solid #bb9af7;
}

#primary-pane .terminal-toast {
    dock: top;
    height: auto;
    max-height: 4;
    background: #24283b;
    border: round #bb9af7;
    color: #c0caf5;
    padding: 0 1;
    display: none;
}

#primary-pane .terminal-toast.visible {
    display: block;
}

#primary-pane .terminal-screen,
#primary-pane TerminalScreenWidget {
    height: 1fr;
    width: 100%;
    min-height: 15;
    background: #13141f;
    border: round #413d63;
    padding: 0 1;
    overflow-y: hidden;
    overflow-x: hidden;
}

#primary-pane .terminal-screen:focus,
#primary-pane TerminalScreenWidget:focus {
    border: round #bb9af7;
}

#primary-pane .terminal-screen.mode-pty:focus,
#primary-pane TerminalScreenWidget.mode-pty:focus {
    border: round #bb9af7;
}

#primary-pane .terminal-screen.mode-normal:focus,
#primary-pane TerminalScreenWidget.mode-normal:focus {
    border: round #e0af68;
}

/* Legacy AgentPane fallback for mock/log streaming */
.agent-pane {
    height: 1fr;
    width: 1fr;
    border: round #3d3b58;
    background: #16161e;
    padding: 0;
    margin: 0;
}

.agent-pane:focus-within {
    border: round #bb9af7;
}

.pane-title-bar {
    dock: top;
    height: 1;
    background: #1f1d2e;
    color: #bb9af7;
    text-style: bold;
    padding: 0 1;
    width: 100%;
    border-bottom: solid #bb9af7;
}

.log-view {
    height: 1fr;
    scrollbar-size: 1 1;
    padding: 0 1;
    background: #13141f;
}

.log-line {
    width: 100%;
    margin: 0;
    padding: 0;
}

.log-timestamp {
    color: #7982a9;
}

.log-thought {
    color: #bb9af7;
}

.log-tool-call {
    color: #7dcfff;
}

.log-result {
    color: #9ece6a;
}

.log-error {
    color: #f7768e;
}

.log-info {
    color: #c0caf5;
}

/* ── Worker Windows (#workers-pane) - Distinct Sky Blue / Cyan Signature ──── */
#workers-pane {
    height: 1fr;
    width: 1fr;
    min-width: 32;
    background: #16161e;
    layout: vertical;
}

/* Zellij-inspired Tab Strip */
WorkerTabBar, #worker-tab-bar {
    dock: top;
    height: 1;
    width: 100%;
    background: #16161e;
    color: #c0caf5;
    padding: 0 1;
    border-bottom: solid #24283b;
}

#worker-tab-strip {
    height: 1;
    width: 100%;
    layout: horizontal;
}

.worker-tab-pill {
    width: auto;
    min-width: 14;
    margin-right: 1;
    padding: 0 1;
    background: #1f2335;
    color: #7aa2f7;
    border: round #292e42;
}

.worker-tab-pill.-active {
    background: #7aa2f7;
    color: #1a1b26;
    text-style: bold;
    border: round #7aa2f7;
}

.worker-tab-pill:hover {
    background: #24283b;
    color: #7dcfff;
    border: round #3b4261;
}

.worker-new-pill {
    width: auto;
    padding: 0 1;
    background: #1f2335;
    color: #9ece6a;
    text-style: bold;
    border: round #292e42;
}

.worker-new-pill:hover {
    background: #24283b;
    color: #a6e3a1;
    border: round #9ece6a;
}

#worker-switcher {
    height: 1fr;
    width: 100%;
}

.worker-terminal-tab {
    height: 1fr;
    width: 100%;
    layout: vertical;
    padding: 0;
    margin: 0;
    background: #16161e;
}

/* Worker Tab Top Status Header */
#workers-pane .terminal-header {
    height: 1;
    dock: top;
    background: #1a2030;
    color: #c0caf5;
    padding: 0 1;
    border-bottom: solid #3b4261;
}

#workers-pane .terminal-toast {
    dock: top;
    height: auto;
    max-height: 4;
    background: #24283b;
    border: round #e0af68;
    color: #c0caf5;
    padding: 0 1;
    display: none;
}

#workers-pane .terminal-toast.visible {
    display: block;
}

/* Worker Terminal Screen Canvas */
#workers-pane .terminal-screen,
#workers-pane TerminalScreenWidget {
    height: 1fr;
    width: 100%;
    min-height: 15;
    background: #0f141c;
    border: round #3b4261;
    padding: 0 1;
    overflow-y: hidden;
    overflow-x: hidden;
}

#workers-pane .terminal-screen:focus,
#workers-pane TerminalScreenWidget:focus {
    border: round #7aa2f7;
}

#workers-pane .terminal-screen.mode-pty:focus,
#workers-pane TerminalScreenWidget.mode-pty:focus {
    border: round #7aa2f7;
}

#workers-pane .terminal-screen.mode-normal:focus,
#workers-pane TerminalScreenWidget.mode-normal:focus {
    border: round #e0af68;
}

/* Generic Fallback for Terminal Screens & Controls */
.terminal-screen,
TerminalScreenWidget {
    height: 1fr;
    width: 100%;
    min-height: 15;
    background: #0f141c;
    border: round #3b4261;
    padding: 0 1;
    overflow-y: hidden;
    overflow-x: hidden;
}

.terminal-screen:focus,
TerminalScreenWidget:focus {
    border: round #7aa2f7;
}

.terminal-screen.mode-pty:focus,
TerminalScreenWidget.mode-pty:focus {
    border: round #7aa2f7;
}

.terminal-screen.mode-normal:focus,
TerminalScreenWidget.mode-normal:focus {
    border: round #e0af68;
}

.terminal-controls {
    height: 1;
    dock: bottom;
    background: #16161e;
    color: #7982a9;
    padding: 0 1;
    border-top: solid #1f2335;
}

.terminal-helper-text {
    width: 100%;
    color: #7982a9;
}

/* ── Bottom Bar (Zellij / Helix Multi-Segment Statusline) ───────────────────── */
BottomBar {
    dock: bottom;
    height: 1;
    width: 100%;
    background: #16161e;
    color: #c0caf5;
}

#bottom-bar {
    dock: bottom;
    height: 1;
    background: #16161e;
    color: #c0caf5;
    layout: horizontal;
    padding: 0 1;
    border-top: solid #24283b;
}

#bottom-bar-container {
    height: 1;
    width: 100%;
    layout: horizontal;
}

#bottom-mode-pill {
    width: auto;
    margin-right: 1;
}

#bottom-actions-container {
    width: 1fr;
    height: 1;
    layout: horizontal;
}

#bottom-normal-actions {
    width: auto;
    height: 1;
    layout: horizontal;
}

#bottom-pty-actions {
    width: auto;
    height: 1;
    layout: horizontal;
    display: none;
}

.action-pill {
    width: auto;
    margin-right: 1;
    padding: 0 1;
    background: #1f2335;
    color: #c0caf5;
    border: round #24283b;
}

.action-pill:hover {
    background: #2f354d;
    color: #7aa2f7;
    text-style: bold;
    border: round #7aa2f7;
}

#bottom-status-pill {
    width: auto;
    color: #7aa2f7;
    text-style: bold;
    padding: 0 1;
}

/* ── Common Modal Screen Overlays ──────────────────────────────────────────── */
ModalScreen {
    align: center middle;
    background: rgba(15, 17, 26, 0.85);
}

/* ── Directive Modal Dialog (Task Dispatcher) ──────────────────────────────── */
#directive-modal {
    align: center middle;
    background: rgba(15, 17, 26, 0.85);
}

#directive-modal-dialog {
    width: 74;
    height: auto;
    max-height: 90%;
    border: round #bb9af7;
    background: #16161e;
    padding: 1 2;
}

#directive-title {
    text-align: center;
    text-style: bold;
    color: #bb9af7;
    margin-bottom: 1;
}

#directive-subtitle {
    text-align: center;
    color: #7982a9;
    margin-bottom: 1;
}

.directive-field, .modal-field {
    margin-bottom: 1;
}

.directive-label, .modal-label {
    text-style: bold;
    color: #7aa2f7;
    margin-bottom: 0;
}

#directive-buttons {
    margin-top: 1;
    align: center middle;
    height: 3;
}

#directive-buttons Button {
    margin: 0 1;
    border: round #3b4261;
}

#btn-inject {
    background: #7aa2f7;
    color: #1a1b26;
    text-style: bold;
    border: round #7aa2f7;
}

#btn-cancel {
    background: #24283b;
    color: #c0caf5;
    border: round #3b4261;
}

/* ── Agent Configuration Modal (Antigravity CLI Style) ─────────────────────── */
AgentConfigModal {
    align: center middle;
    background: rgba(15, 17, 26, 0.85);
}

#agent-config-dialog {
    width: 92;
    max-width: 96%;
    height: 32;
    max-height: 92%;
    border: round #7aa2f7;
    background: #16161e;
    padding: 1 2;
}

#config-search-box {
    height: 3;
    width: 100%;
    margin-bottom: 1;
    layout: horizontal;
}

#config-search-prompt {
    width: 9;
    color: #7aa2f7;
    text-style: bold;
    padding-top: 1;
}

#config-search-input {
    width: 1fr;
    background: #1a1b26;
    color: #c0caf5;
    border: round #3b4261;
}

#config-search-input:focus {
    border: round #7aa2f7;
    background: #24283b;
    color: #ffffff;
}

#config-settings-view {
    height: 1fr;
    width: 100%;
    background: #16161e;
    color: #c0caf5;
}

#config-description-view {
    height: 2;
    width: 100%;
    border-top: solid #292e42;
    color: #9aa5ce;
    padding-top: 1;
}

#config-footer-hints {
    height: 1;
    width: 100%;
    text-align: center;
    color: #7982a9;
    background: #1a1b26;
    margin-top: 1;
}

/* ── Help Modal Dialog ─────────────────────────────────────────────────────── */
#help-modal {
    align: center middle;
    background: rgba(15, 17, 26, 0.85);
}

#help-dialog {
    width: 72;
    height: auto;
    max-height: 85%;
    border: round #7aa2f7;
    padding: 1 2;
    background: #16161e;
}

#help-title {
    text-align: center;
    text-style: bold;
    color: #7aa2f7;
    margin-bottom: 1;
    width: 100%;
}

#help-content {
    height: auto;
    max-height: 28;
    padding: 0 1;
}

/* ── Session Picker Screen ─────────────────────────────────────────────────── */
#session-picker-container {
    width: 100%;
    height: 100%;
    align: center middle;
    background: #1a1b26;
}

#picker-panel {
    width: 74;
    height: auto;
    max-height: 80%;
    border: round #7aa2f7;
    padding: 1 2;
    background: #16161e;
}

#picker-title {
    text-align: center;
    text-style: bold;
    color: #7aa2f7;
    margin-bottom: 1;
    width: 100%;
}

#picker-subtitle {
    text-align: center;
    color: #7982a9;
    margin-bottom: 1;
    width: 100%;
}

#session-list {
    height: auto;
    max-height: 16;
    margin: 1 0;
    background: #1f2335;
    border: round #3b4261;
}

#session-list > .option-list--option {
    padding: 0 1;
}

#session-list > .option-list--option.-highlight {
    background: #24283b;
    color: #7aa2f7;
    text-style: bold;
}

#picker-footer {
    text-align: center;
    color: #7982a9;
    margin-top: 1;
    width: 100%;
}

/* ── New Session Modal Dialog ──────────────────────────────────────────────── */
#new-session-modal {
    align: center middle;
    background: rgba(15, 17, 26, 0.85);
}

#new-session-dialog {
    width: 64;
    height: auto;
    border: round #7aa2f7;
    padding: 1 2;
    background: #16161e;
}

#modal-title {
    text-align: center;
    text-style: bold;
    color: #7aa2f7;
    margin-bottom: 1;
    width: 100%;
}

#session-name-input, #agent-count-input, #session-goal-input {
    border: round #3b4261;
    background: #1a1b26;
    color: #c0caf5;
}

#session-name-input:focus, #agent-count-input:focus, #session-goal-input:focus {
    border: round #7aa2f7;
    background: #24283b;
    color: #ffffff;
}

#modal-buttons {
    margin-top: 1;
    align: center middle;
    height: 3;
}

#modal-buttons Button {
    margin: 0 1;
    border: round #3b4261;
}

#btn-create {
    background: #9ece6a;
    color: #1a1b26;
    text-style: bold;
    border: round #9ece6a;
}

/* ── Directive Editor Modal (In-App Markdown Editor) ───────────────────────── */
#directive-editor-dialog {
    width: 88;
    max-width: 95%;
    height: 26;
    max-height: 90%;
    border: round #bb9af7;
    background: #16161e;
    padding: 1 2;
}

#directive-editor-title {
    text-align: center;
    color: #bb9af7;
    margin-bottom: 1;
}

#directive-text-area {
    height: 1fr;
    width: 100%;
    background: #1a1b26;
    color: #c0caf5;
    border: round #3b4261;
}

#directive-text-area:focus {
    border: round #bb9af7;
    background: #13141f;
}

#directive-editor-buttons {
    height: 3;
    margin-top: 1;
    align: center middle;
}

#directive-editor-buttons Button {
    margin: 0 1;
    border: round #3b4261;
}

#btn-save-directive {
    background: #9ece6a;
    color: #1a1b26;
    text-style: bold;
    border: round #9ece6a;
}

#btn-open-ext {
    background: #7aa2f7;
    color: #1a1b26;
    text-style: bold;
    border: round #7aa2f7;
}

#btn-cancel-directive {
    background: #24283b;
    color: #c0caf5;
    border: round #3b4261;
}

/* ── Generic Form Controls & Textual Widgets (Rounded & Styled) ───────────── */
Input {
    border: round #3b4261;
    background: #1a1b26;
    color: #c0caf5;
}

Input:focus {
    border: round #7aa2f7;
    background: #24283b;
    color: #ffffff;
}

Select {
    border: round #3b4261;
    background: #1f2335;
    color: #c0caf5;
}

Select:focus {
    border: round #7aa2f7;
    color: #ffffff;
}

OptionList {
    border: round #3b4261;
    background: #1f2335;
    color: #c0caf5;
}

OptionList:focus {
    border: round #7aa2f7;
}

Button {
    border: round #3b4261;
    background: #24283b;
    color: #c0caf5;
}

Button:focus {
    border: round #7aa2f7;
    color: #ffffff;
}

Button:hover {
    background: #343b58;
}
