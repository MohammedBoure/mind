/* ══════════════════════════════════════════════════════════════════
   mind — Global Tokyo Night / Zellij Stylesheet
   Modern, sleek terminal multiplexer styling with high-contrast accents
   ══════════════════════════════════════════════════════════════════ */

/* ── Screen & Base Theme ─────────────────────────────────────────── */
Screen {
    background: #1a1b26;
    color: #c0caf5;
}

/* ── Header Bar (Zellij Streamlined Top Bar) ───────────────────────── */
#header-bar {
    dock: top;
    height: 1;
    background: #16161e;
    color: #c0caf5;
    layout: horizontal;
    padding: 0 1;
}

#brand-pill {
    width: auto;
    text-style: bold;
    color: #7aa2f7;
    margin-right: 1;
}

#session-pill {
    width: auto;
    color: #bb9af7;
    background: #24283b;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

#mode-badge {
    width: auto;
    margin-right: 1;
}

#header-spacer {
    width: 1fr;
}

#mcp-indicator {
    width: auto;
    color: #9ece6a;
    background: #1f2335;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}

#worker-count-pill {
    width: auto;
    color: #e0af68;
    background: #24283b;
    padding: 0 1;
    text-style: bold;
}

/* ── Interrupt Banner (Global Toast Alert) ───────────────────────── */
#interrupt-banner {
    dock: top;
    height: auto;
    max-height: 5;
    display: none;
    background: #292e42;
    border-bottom: heavy #e0af68;
    color: #c0caf5;
    padding: 0 2;
    margin: 0;
}

#interrupt-banner.visible {
    display: block;
}

.interrupt-header {
    text-style: bold;
    color: #e0af68;
}

.interrupt-sender {
    text-style: bold;
    color: #bb9af7;
}

.interrupt-priority-critical {
    color: #f7768e;
    text-style: bold;
}

.interrupt-priority-high {
    color: #ff9e64;
    text-style: bold;
}

.interrupt-priority-normal {
    color: #9ece6a;
}

.interrupt-priority-low {
    color: #565f89;
}

/* ── Workspace Split Layout ───────────────────────────────────────── */
#workspace-container {
    height: 1fr;
    width: 100%;
    layout: horizontal;
    background: #1a1b26;
}

/* ── Primary Agent Pane ──────────────────────────────────────────── */
.agent-pane {
    height: 1fr;
    width: 1fr;
    border: round #3b4261;
    background: #16161e;
    padding: 0;
    margin: 0;
}

.agent-pane:focus-within {
    border: round #7aa2f7;
}

#primary-pane {
    height: 1fr;
    width: 1fr;
    min-width: 30;
}

.pane-title-bar {
    dock: top;
    height: 1;
    background: #1f2335;
    color: #7aa2f7;
    text-style: bold;
    padding: 0 1;
    width: 100%;
    border-bottom: solid #3b4261;
}

.log-view {
    height: 1fr;
    scrollbar-size: 1 1;
    padding: 0 1;
    background: #16161e;
}

.log-line {
    width: 100%;
    margin: 0;
    padding: 0;
}

.log-timestamp {
    color: #565f89;
}

.log-thought {
    color: #bb9af7;
}

.log-tool-call {
    color: #7dcfff;
}

.log-result {
    color: #9ece6a;
}

.log-error {
    color: #f7768e;
}

.log-info {
    color: #c0caf5;
}

/* ── Worker Terminal Panes & Tabs ────────────────────────────────── */
#workers-pane {
    height: 1fr;
    width: 1fr;
    min-width: 30;
    layout: vertical;
}

#worker-tabs {
    height: 1fr;
    width: 100%;
    background: #16161e;
}

#worker-tabs ContentTab {
    background: #1f2335;
    color: #565f89;
    padding: 0 2;
}

#worker-tabs ContentTab.-active {
    background: #24283b;
    color: #7aa2f7;
    text-style: bold;
    border-bottom: tall #7aa2f7;
}

.worker-terminal-tab {
    height: 1fr;
    width: 100%;
    layout: vertical;
    padding: 0;
    margin: 0;
    background: #0f141c;
}

.terminal-header {
    height: 1;
    dock: top;
    background: #1f2335;
    color: #c0caf5;
    padding: 0 1;
    border-bottom: solid #3b4261;
}

.terminal-toast {
    dock: top;
    height: auto;
    max-height: 4;
    background: #292e42;
    border-bottom: solid #e0af68;
    color: #c0caf5;
    padding: 0 1;
    display: none;
}

.terminal-toast.visible {
    display: block;
}

.terminal-screen {
    height: 1fr;
    width: 100%;
    min-height: 15;
    background: #0f141c;
    border: round #3b4261;
    padding: 0 1;
    overflow-y: hidden;
    overflow-x: hidden;
}

.terminal-screen:focus {
    border: round #e0af68;
}

.terminal-screen.mode-pty:focus {
    border: round #7aa2f7;
}

.terminal-screen.mode-normal:focus {
    border: round #e0af68;
}

.terminal-controls {
    height: 1;
    dock: bottom;
    background: #16161e;
    color: #565f89;
    padding: 0 1;
    border-top: solid #1f2335;
}

.terminal-helper-text {
    width: 100%;
    color: #565f89;
}

/* ── Bottom Bar (Interactive Multi-Segment Status Bar) ───────────── */
#bottom-bar {
    dock: bottom;
    height: 1;
    background: #16161e;
    color: #c0caf5;
    layout: horizontal;
    padding: 0 1;
}

#bottom-bar-container {
    height: 1;
    width: 100%;
    layout: horizontal;
}

#bottom-mode-pill {
    width: auto;
    margin-right: 1;
}

#bottom-actions-container {
    width: 1fr;
    height: 1;
    layout: horizontal;
}

#bottom-normal-actions {
    width: auto;
    height: 1;
    layout: horizontal;
}

#bottom-pty-actions {
    width: auto;
    height: 1;
    layout: horizontal;
    display: none;
}

.action-pill {
    width: auto;
    margin-right: 1;
    padding: 0 1;
    background: #24283b;
    color: #c0caf5;
}

.action-pill:hover {
    background: #3b4261;
    color: #7aa2f7;
    text-style: bold;
}

#bottom-status-pill {
    width: auto;
    color: #7aa2f7;
    text-style: bold;
}

/* ── Directive Injection Modal ────────────────────────────────────── */
#directive-modal {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#directive-modal-dialog {
    width: 72;
    height: auto;
    border: thick #bb9af7;
    background: #1a1b26;
    padding: 1 2;
}

#directive-title {
    text-align: center;
    text-style: bold;
    color: #bb9af7;
    margin-bottom: 1;
}

.directive-field {
    margin-bottom: 1;
}

.directive-label {
    text-style: bold;
    color: #7aa2f7;
    margin-bottom: 0;
}

#directive-buttons {
    margin-top: 1;
    align: center middle;
    height: 3;
}

#directive-buttons Button {
    margin: 0 1;
}

#btn-inject {
    background: #7aa2f7;
    color: #1a1b26;
    text-style: bold;
}

#btn-cancel {
    background: #24283b;
    color: #c0caf5;
}

/* ── Help Modal ──────────────────────────────────────────────────── */
#help-modal {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#help-dialog {
    width: 70;
    height: auto;
    max-height: 85%;
    border: thick #7aa2f7;
    padding: 1 2;
    background: #1a1b26;
}

#help-title {
    text-align: center;
    text-style: bold;
    color: #7aa2f7;
    margin-bottom: 1;
    width: 100%;
}

#help-content {
    height: auto;
    max-height: 28;
    padding: 0 1;
}

/* ── Session Picker Screen ───────────────────────────────────────── */
#session-picker-container {
    width: 100%;
    height: 100%;
    align: center middle;
    background: #1a1b26;
}

#picker-panel {
    width: 72;
    height: auto;
    max-height: 80%;
    border: thick #7aa2f7;
    padding: 1 2;
    background: #16161e;
}

#picker-title {
    text-align: center;
    text-style: bold;
    color: #7aa2f7;
    margin-bottom: 1;
    width: 100%;
}

#picker-subtitle {
    text-align: center;
    color: #565f89;
    margin-bottom: 1;
    width: 100%;
}

#session-list {
    height: auto;
    max-height: 16;
    margin: 1 0;
    background: #1f2335;
    border: round #3b4261;
}

#session-list > .option-list--option {
    padding: 0 1;
}

#picker-footer {
    text-align: center;
    color: #565f89;
    margin-top: 1;
    width: 100%;
}

/* ── New Session Modal ───────────────────────────────────────────── */
#new-session-modal {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#new-session-dialog {
    width: 62;
    height: auto;
    border: thick #7aa2f7;
    padding: 1 2;
    background: #1a1b26;
}

#modal-title {
    text-align: center;
    text-style: bold;
    color: #7aa2f7;
    margin-bottom: 1;
    width: 100%;
}

.modal-field {
    margin-bottom: 1;
}

.modal-label {
    margin-bottom: 0;
    color: #7aa2f7;
    text-style: bold;
}

#modal-buttons {
    margin-top: 1;
    align: center middle;
    height: 3;
}

#modal-buttons Button {
    margin: 0 1;
}
