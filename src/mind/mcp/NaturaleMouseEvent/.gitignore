# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Compressed archives
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Database & Large Dataset files
*.sqlite3
*.sqlite
*.db
*.npz

# Generated Plots & Images (allow documentation images in docs/)
*.png
*.jpg
*.jpeg
*.svg
!docs/*.png
!docs/*.jpg
!docs/*.jpeg
!docs/*.svg

# Log files
*.log

# IDE & OS System files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Exceptions: Preserve trained PyTorch model weights
!models/*.pth
!models/*.pt
!human_mouse_engine/*.pt
