/* ══════════════════════════════════════════════════════════════════
   mind · micro — Global Stylesheet
   Zellij-inspired terminal multiplexer theme
   ══════════════════════════════════════════════════════════════════ */

/* ── Screen Defaults ─────────────────────────────────────────────── */
Screen {
    background: $surface;
}

/* ── Session Picker Screen ───────────────────────────────────────── */
#session-picker-container {
    width: 100%;
    height: 100%;
    align: center middle;
}

#picker-panel {
    width: 70;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    padding: 1 2;
    background: $surface;
}

#picker-title {
    text-align: center;
    text-style: bold;
    color: $text;
    margin-bottom: 1;
    width: 100%;
}

#picker-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
    width: 100%;
}

#session-list {
    height: auto;
    max-height: 16;
    margin: 1 0;
    background: $surface-darken-1;
}

#session-list > .option-list--option {
    padding: 0 1;
}

#picker-footer {
    text-align: center;
    color: $text-muted;
    margin-top: 1;
    width: 100%;
}

/* ── New Session Modal ───────────────────────────────────────────── */
#new-session-modal {
    align: center middle;
}

#new-session-dialog {
    width: 60;
    height: auto;
    border: thick $accent;
    padding: 1 2;
    background: $surface;
}

#modal-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
    width: 100%;
}

.modal-field {
    margin-bottom: 1;
}

.modal-label {
    margin-bottom: 0;
    color: $text;
    text-style: bold;
}

#modal-buttons {
    margin-top: 1;
    align: center middle;
    height: 3;
}

#modal-buttons Button {
    margin: 0 1;
}

/* ── Header Bar ──────────────────────────────────────────────────── */
#header-bar {
    dock: top;
    height: 3;
    background: $primary-darken-2;
    color: $text;
    layout: horizontal;
    padding: 0 1;
}

#session-badge {
    width: auto;
    min-width: 20;
    height: 3;
    content-align: left middle;
    padding: 0 2;
    background: $primary-darken-3;
    text-style: bold;
    color: $text;
}

#status-indicator {
    width: auto;
    min-width: 12;
    height: 3;
    content-align: center middle;
    padding: 0 1;
    color: $success;
}

#agent-tabs {
    height: 3;
    width: 1fr;
    background: $primary-darken-2;
}

#agent-tabs .underline--bar .underline--bar--inactive {
    color: $text-muted 30%;
}

#agent-tabs .underline--bar .underline--bar--active {
    color: $accent;
}

/* ── Bottom Bar ──────────────────────────────────────────────────── */
#bottom-bar {
    dock: bottom;
    height: 1;
    background: $primary-darken-3;
    color: $text-muted;
    layout: horizontal;
    padding: 0 1;
}

.keybind-hint {
    width: auto;
    margin: 0 1 0 0;
    color: $text-muted;
}

.keybind-key {
    text-style: bold;
    color: $accent;
}

/* ── Workspace Container ─────────────────────────────────────────── */
#workspace-container {
    height: 1fr;
    layout: horizontal;
}

/* ── Agent Pane ──────────────────────────────────────────────────── */
.agent-pane {
    height: 1fr;
    border: round $primary-darken-1;
    padding: 0;
    margin: 0;
}

.agent-pane:focus-within {
    border: round $accent;
}

#primary-pane {
    width: 1fr;
}

#workers-pane {
    width: 1fr;
}

.pane-title-bar {
    dock: top;
    height: 1;
    background: $primary-darken-1;
    color: $text;
    text-style: bold;
    padding: 0 1;
    width: 100%;
}

/* ── Log View ────────────────────────────────────────────────────── */
.log-view {
    height: 1fr;
    scrollbar-size: 1 1;
    padding: 0 1;
    background: $surface;
}

.log-line {
    width: 100%;
    margin: 0;
    padding: 0;
}

.log-timestamp {
    color: $text-muted;
}

.log-thought {
    color: #a78bfa;
}

.log-tool-call {
    color: #38bdf8;
}

.log-result {
    color: #4ade80;
}

.log-error {
    color: #f87171;
}

.log-info {
    color: $text;
}

/* ── Interrupt Banner ────────────────────────────────────────────── */
#interrupt-banner {
    dock: top;
    height: auto;
    max-height: 6;
    display: none;
    background: $warning-darken-2;
    color: $text;
    padding: 0 2;
    margin: 0;
    border-bottom: solid $warning;
}

#interrupt-banner.visible {
    display: block;
}

.interrupt-header {
    text-style: bold;
    color: $warning;
}

.interrupt-sender {
    text-style: bold;
    color: $accent;
}

.interrupt-priority-critical {
    color: #f87171;
    text-style: bold;
}

.interrupt-priority-high {
    color: #fb923c;
    text-style: bold;
}

.interrupt-priority-normal {
    color: #a3e635;
}

.interrupt-priority-low {
    color: $text-muted;
}

/* ── Worker Tabs ─────────────────────────────────────────────────── */
#worker-tabs {
    height: 3;
    background: $primary-darken-1;
}

#worker-tab-content {
    height: 1fr;
}

/* ── Help Modal ──────────────────────────────────────────────────── */
#help-modal {
    align: center middle;
}

#help-dialog {
    width: 65;
    height: auto;
    max-height: 85%;
    border: thick $accent;
    padding: 1 2;
    background: $surface;
}

#help-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
    width: 100%;
}

#help-content {
    height: auto;
    max-height: 30;
    padding: 0 1;
}

.help-section {
    margin-bottom: 1;
}

.help-section-title {
    text-style: bold underline;
    color: $text;
    margin-bottom: 0;
}

.help-row {
    layout: horizontal;
    height: 1;
}

.help-key {
    width: 20;
    text-style: bold;
    color: $accent;
}

.help-desc {
    width: 1fr;
    color: $text;
}
